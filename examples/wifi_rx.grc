- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import socket\nimport struct\nimport pmt\nimport time\nimport numpy\
      \ as np\nfrom gnuradio import gr\n\nclass UDPTagSender(gr.basic_block):\n  \
      \  def __init__(self, udp_ip=\"127.0.0.1\", udp_port=5005):\n        gr.basic_block.__init__(self,\n\
      \            name=\"UDP Tag Sender\",\n            in_sig=[(np.complex64, 1)],\
      \  # Assuming complex samples\n            out_sig=None)\n        \n       \
      \ self.udp_ip = udp_ip\n        self.udp_port = udp_port\n        self.sock\
      \ = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)\n        self.mac_address\
      \ = \"00:11:22:33:44:55\"  # Replace with actual MAC\n\n    def general_work(self,\
      \ input_items, output_items):\n        nread = self.nitems_read(0)  # Get the\
      \ starting sample index\n        tags = self.get_tags_in_window(0, 0, len(input_items[0]))\n\
      \        for tag in tags:\n            key = pmt.to_python(tag.key) # convert\
      \ from PMT to python string\n            value = pmt.to_python(tag.value) #\
      \ Note that the type(value) can be several things, it depends what PMT type\
      \ it was\n            print(f\"key: {key}\")\n            print(f\"value: {value}\
      \ as {type(value)}\")\n             \n        timestamp = time.time()  # Dummy\
      \ timestamp (current time)\n        mac_address = bytes.fromhex(\"001122334455\"\
      )  # Dummy MAC address (6 bytes)\n        \n        packet_data = struct.pack(\"\
      !d6s\", timestamp, mac_address)  # 8 bytes timestamp + 6 bytes MAC\n       \
      \ \n        self.sock.sendto(packet_data, (self.udp_ip, self.udp_port))\n\n\
      \        self.consume(0, len(input_items[0]))  # Consume all samples\n     \
      \   return 0\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    udp_ip: '''127.0.0.1'''
    udp_port: '5005'
  states:
    _io_cache: ('UDP Tag Sender', 'UDPTagSender', [('udp_ip', "'127.0.0.1'"), ('udp_port',
      '5005')], [('0', 'complex', 1)], [], '', ['udp_ip', 'udp_port'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1024, 436.0]
    rotation: 0
    state: disabled
- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "import socket\nfrom gnuradio import gr\n\nclass udp_sender(gr.basic_block):\n\
      \    def __init__(self, host=\"127.0.0.1\", port=5005, node_id=0):\n       \
      \ gr.basic_block.__init__(self,\n            name=\"udp_sender\",\n        \
      \    in_sig=None,   # No regular input signal, only messages\n            out_sig=None)\n\
      \n        self.host = host\n        self.port = port\n        self.sock = socket.socket(socket.AF_INET,\
      \ socket.SOCK_DGRAM)\n        self.node_id = node_id\n\n        # Register message\
      \ input port\n        self.message_port_register_in(gr.pmt.intern(\"in\"))\n\
      \        self.set_msg_handler(gr.pmt.intern(\"in\"), self.handle_msg)\n\n  \
      \  def handle_msg(self, msg):\n        \"\"\"Handles incoming messages and sends\
      \ them over UDP.\"\"\"\n        # template dict with dummy values\n        msg_dict\
      \ = {\"node\": \"\",\"wifi_toa\": 0.0, \"address 3\": \"\", \"address 2\": \"\
      \", \"address 1\": \"\", \"sequence number\": \"\", \"ssid\": \"\", \"subtype\"\
      : \"\", \"type\": \"\", \"duration\": \"\", \"dlt\": \"\", \"frame bytes\":\
      \ \"\", \"encoding\": \"\", \"snr\": \"\", \"nominal frequency\": \"\", \"frequency\
      \ offset\": \"\", \"beta\": \"\", \"csi\": []}\n        msg_dict[\"node\"] =\
      \ self.node_id\n        \n        try:\n            print(\"=+===========================================================\"\
      )\n            \n            # Send the serialized message over UDP\n      \
      \      msg_str = str.split(str(msg), \") (\")\n            remove_chars = [\"\
      (\", \")\", \"#\", \"[\", \"]\", \"'\"]\n            for c in remove_chars:\n\
      \                msg_str = [m.replace(c, \"\") for m in msg_str]\n         \
      \       # print(f\"Message: {msg_str}\")\n            for m in msg_str:\n  \
      \              tmp = m.split(\" . \")\n                # print(f\"Tmp: {tmp}\"\
      )\n                if len(tmp) > 1:\n                    try:\n            \
      \            msg_dict[tmp[0]] = tmp[1]\n                        print(f\"Key:\
      \ {tmp[0]}, Value: {tmp[1]}\")\n                    except:\n              \
      \          print(f\"Error parsing message: {tmp}\")\n                      \
      \  pass\n\n                \n            self.sock.sendto(str(msg_dict).encode('utf-8'),\
      \ (self.host, self.port))\n        except Exception as e:\n            print(f\"\
      Error sending UDP message: {e}\")\n\nif __name__ == \"__main__\":\n    # Create\
      \ the UDP sender block\n    sender = udp_sender(host=\"127.0.0.1\", port=5005)\n\
      \    message = \"((address 3 . 48:2c:d0:3c:db:82) (address 2 . 48:2c:d0:3c:db:82)\
      \ (address 1 . ff:ff:ff:ff:ff:ff) (sequence number . 212) (ssid . eduroam) (subtype\
      \ . Beacon) (type . management) (duration . 0) (dlt . 105) (frame bytes . 370)\
      \ (encoding . 0) (snr . 18.5551) (nominal frequency . 2.412e+09) (frequency\
      \ offset . -21147.7) (beta . 0.907213) (csi . #[(0.566118,-0.298401) (0.631518,-0.245726)\
      \ (0.657571,-0.144538) (0.690639,0.0103949) (0.678849,0.072456) (0.680707,0.0461684)\
      \ (0.591707,0.162084) (0.478976,0.212965) (0.451279,0.239542) (0.387056,0.253145)\
      \ (0.250386,0.159893) (0.191558,0.107284) (0.171853,0.118913) (0.0702613,-0.0185443)\
      \ (0.109905,-0.146988) (0.0742382,-0.270683) (0.165585,-0.379584) (0.168831,-0.497667)\
      \ (0.354727,-0.591889) (0.437455,-0.557083) (0.570716,-0.612538) (0.77234,-0.635723)\
      \ (0.912641,-0.598075) (0.93393,-0.483502) (1.00211,-0.349984) (1.08942,-0.176415)\
      \ (0.943632,0.156554) (0.82913,0.334521) (0.568084,0.285006) (0.462272,0.267365)\
      \ (0.253101,0.193681) (0.109876,0.0587345) (0.087862,-0.102265) (0.031854,-0.287846)\
      \ (0.198047,-0.43826) (0.38686,-0.529481) (0.521877,-0.604409) (0.747475,-0.603303)\
      \ (0.99424,-0.58217) (1.12874,-0.440593) (1.28294,-0.222313) (1.36439,0.0103244)\
      \ (1.27361,0.252473) (1.2032,0.410093) (1.0735,0.546541) (0.885395,0.565614)\
      \ (0.754109,0.613179) (0.580458,0.516457) (0.556105,0.360515) (0.411728,0.209677)\
      \ (0.452793,0.0442217) (0.580392,-0.111653)]) (wifi_toa . 0.297104))\"\n   \
      \ sender.handle_msg(message)"
    affinity: ''
    alias: ''
    comment: ''
    host: udp_ip_address
    maxoutbuf: '0'
    minoutbuf: '0'
    node_id: '0'
    port: udp_port
  states:
    _io_cache: ('udp_sender', 'udp_sender', [('host', "'127.0.0.1'"), ('port', '5005'),
      ('node_id', '0')], [('in', 'message', 1)], [], '', ['host', 'node_id', 'port'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [632, 1036.0]
    rotation: 0
    state: disabled
- name: epy_block_2
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Blocks:\n\nEach time this file is saved,\
      \ GRC will instantiate the first class it finds\nto get ports and parameters\
      \ of your block. The arguments to __init__  will\nbe the parameters. All of\
      \ them are required to have default values!\n\"\"\"\nimport pmt\nimport numpy\
      \ as np\nfrom gnuradio import gr\n\nimport datetime\n\n\n\nclass blk(gr.sync_block):\
      \  # other base classes are basic_block, decim_block, interp_block\n    \"\"\
      \"Embedded Python Block example - a simple multiply const\"\"\"\n\n    def __init__(self,\
      \ format_timestamp=1):  # only default arguments here\n        \"\"\"arguments\
      \ to this function show up as parameters in GRC\"\"\"\n        gr.sync_block.__init__(\n\
      \            self,\n            name='Print DroneID Packets',   # will show\
      \ up in GRC\n            in_sig=None,\n            out_sig=None\n        )\n\
      \        # if an attribute with the same name as a parameter is found,\n   \
      \     # a callback is registered (properties work, too).\n        self.format_timestamp\
      \ = int(format_timestamp)\n        self.message_port_register_in(gr.pmt.intern(\"\
      in\"))\n        self.set_msg_handler(gr.pmt.intern(\"in\"), self.handle_msg)\n\
      \        self.id = 0\n        \n    def handle_msg(self, msg):\n        msg\
      \ = pmt.to_python(msg)\n        try:\n            mac_tx = [msg[0]['address\
      \ 2'], msg[0]['address 1'], msg[0]['address 3']]\n            if \"e8:94:f6:09:ae:bd\"\
      \ in mac_tx:\n                if self.format_timestamp == 1:\n             \
      \       #timestamp = msg[0]['wifi_toa']\n                    #seconds = int(timestamp)\
      \  # Extract seconds\n                    #nanoseconds = int((timestamp - seconds)\
      \ * 1e9)  # Extract nanoseconds\n\n                    #formatted_time = f\"\
      {datetime.utcfromtimestamp(seconds).strftime('%Y-%m-%d %H:%M:%S')}.{nanoseconds:09d}\"\
      \n                    timestamp = msg[0]['wifi_toa']\n                    dt\
      \ = datetime.datetime.utcfromtimestamp(timestamp)\n                    formatted_time\
      \ = dt.strftime('%Y-%m-%d %H:%M:%S.%f')  # Microseconds included\n\n       \
      \             print(f\"[{self.id}] DroneID Packet found: {formatted_time} -\
      \ {msg[1]} {mac_tx}\")\n                else:\n                    print (f\"\
      [{self.id}] DroneID Packet found: {msg[0]['wifi_toa']:.9f} - {msg[1]} {mac_tx}\"\
      )\n                self.id = self.id + 1\n        except:\n            pass\n"
    affinity: ''
    alias: ''
    comment: ''
    format_timestamp: '1'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Print DroneID Packets', 'blk', [('format_timestamp', '1')], [('in',
      'message', 1)], [], 'Embedded Python Block example - a simple multiply const',
      ['format_timestamp'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [800, 1076.0]
    rotation: 0
    state: true
